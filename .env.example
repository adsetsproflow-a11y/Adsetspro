# ==========================================
# SAAA SaaS Platform Environment Variables Template
# ==========================================

# PostgreSQL Database (Neon / Supabase)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Production Domain & Application URL
APP_URL="https://adsetsproflow.com"
NEXT_PUBLIC_APP_URL="https://adsetsproflow.com"

# Optional Root Domain for Shared Cookies across subdomains (e.g. .adsetsproflow.com)
# COOKIE_DOMAIN=".adsetsproflow.com"

# JWT Token Configuration
JWT_ACCESS_SECRET="generate-a-strong-random-64-character-secret"
JWT_REFRESH_SECRET="generate-another-strong-random-64-character-secret"
JWT_ISSUER="saaa-platform"
JWT_AUDIENCE="saaa-platform-users"

# Initial Super Admin Seed (Used by seed script)
SUPER_ADMIN_NAME="Platform Super Admin"
SUPER_ADMIN_EMAIL="owner@adsetsproflow.com"
SUPER_ADMIN_PASSWORD="ChangeThisPassword123!"

# Transactional Email Provider (Resend or leave blank for development preview)
RESEND_API_KEY="re_123456789"
EMAIL_FROM="Adsetspro Flow <notifications@adsetsproflow.com>"
