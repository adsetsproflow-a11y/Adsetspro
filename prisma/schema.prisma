// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GlobalRole {
  SUPER_ADMIN
  USER
}

enum CompanyRole {
  COMPANY_ADMIN
  EMPLOYEE
}

enum CompanyStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  COMPLETED
}

// 1. User: Global user identity
model User {
  id              String         @id @default(uuid())
  name            String
  email           String         @unique
  passwordHash    String
  globalRole      GlobalRole     @default(USER)
  accountStatus   AccountStatus  @default(ACTIVE)
  emailVerifiedAt DateTime?
  avatarUrl       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  memberships            CompanyMembership[]
  sentInvitations        Invitation[]             @relation("InvitedByUser")
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens    PasswordResetToken[]
  refreshTokens          RefreshToken[]
  createdProjects        Project[]                @relation("ProjectCreator")
  createdTasks           Task[]                   @relation("TaskCreator")
  assignedTasks          TaskAssignment[]         @relation("AssignedToUser")
  assignedByTasks        TaskAssignment[]         @relation("AssignedByUser")
  uploadedAttachments    TaskAttachment[]         @relation("AttachmentUploader")
  taskComments           TaskComment[]            @relation("CommentAuthor")
  taskActivities         TaskActivity[]           @relation("ActivityActor")
  notifications          Notification[]           @relation("UserNotifications")
  auditLogs              AuditLog[]               @relation("AuditActor")
  approvedCompanies      Company[]                @relation("CompanyApprover")

  @@index([email])
  @@index([globalRole])
  @@index([accountStatus])
}

// 2. Company: Company workspace
model Company {
  id           String        @id @default(uuid())
  name         String
  slug         String        @unique
  status       CompanyStatus @default(PENDING)
  rejectionReason String?
  suspensionReason String?
  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?         @relation("CompanyApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  memberships     CompanyMembership[]
  invitations     Invitation[]
  projects        Project[]
  tasks           Task[]
  taskAssignments TaskAssignment[]
  taskAttachments TaskAttachment[]
  taskComments    TaskComment[]
  taskActivities  TaskActivity[]
  notifications   Notification[]
  auditLogs       AuditLog[]

  @@index([slug])
  @@index([status])
  @@index([createdAt])
}

// 3. CompanyMembership: User's membership in a company
model CompanyMembership {
  id               String           @id @default(uuid())
  userId           String
  companyId        String
  role             CompanyRole      @default(EMPLOYEE)
  designation      String?          // e.g. Designer, Developer, Video Editor, Manager
  department       String?          // e.g. Development, Design, Content, Marketing
  membershipStatus MembershipStatus @default(ACTIVE)
  joinedAt         DateTime         @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([userId])
  @@index([role])
  @@index([membershipStatus])
}

// 4. Invitation: Employee invitation
model Invitation {
  id          String           @id @default(uuid())
  companyId   String
  email       String
  name        String
  designation String?
  department  String?
  tokenHash   String           @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String
  createdAt   DateTime         @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("InvitedByUser", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([email])
  @@index([tokenHash])
  @@index([status])
  @@index([expiresAt])
}

// 5. EmailVerificationToken: Email verification
model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

// 6. PasswordResetToken: Password recovery
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

// 7. RefreshToken: Refresh token/session management
model RefreshToken {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  replacedById String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

// 8. Project: Company projects
model Project {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  description String?
  status      String   @default("active")
  createdById String
  createdAt   DateTime @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User    @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([companyId])
  @@index([createdById])
}

// 9. Task: Company tasks
model Task {
  id          String       @id @default(uuid())
  companyId   String
  projectId   String?
  title       String
  description String?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  rewardXp    Int          @default(100)
  dueDate     DateTime
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project     Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy   User             @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  assignments TaskAssignment[]
  attachments TaskAttachment[]
  comments    TaskComment[]
  activities  TaskActivity[]

  @@index([companyId])
  @@index([projectId])
  @@index([status])
  @@index([dueDate])
  @@index([createdById])
}

// 10. TaskAssignment: Task-to-employee assignment
model TaskAssignment {
  id             String   @id @default(uuid())
  taskId         String
  companyId      String
  assignedUserId String
  assignedById   String
  assignedAt     DateTime @default(now())

  task         Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  company      Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedUser User    @relation("AssignedToUser", fields: [assignedUserId], references: [id], onDelete: Cascade)
  assignedBy   User    @relation("AssignedByUser", fields: [assignedById], references: [id], onDelete: Cascade)

  @@unique([taskId, assignedUserId])
  @@index([taskId])
  @@index([companyId])
  @@index([assignedUserId])
  @@index([assignedById])
}

// 11. TaskAttachment: Secure file metadata
model TaskAttachment {
  id           String   @id @default(uuid())
  companyId    String
  taskId       String
  uploadedById String
  storageKey   String
  originalName String
  mimeType     String
  sizeBytes    BigInt
  version      Int      @default(1)
  createdAt    DateTime @default(now())

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  task       Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([taskId])
  @@index([uploadedById])
}

// 12. TaskComment: Task discussion
model TaskComment {
  id        String   @id @default(uuid())
  companyId String
  taskId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user    User    @relation("CommentAuthor", fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([taskId])
  @@index([userId])
}

// 13. TaskActivity: Task history
model TaskActivity {
  id        String   @id @default(uuid())
  companyId String
  taskId    String
  actorId   String
  action    String
  details   String?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor   User    @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([taskId])
  @@index([actorId])
  @@index([createdAt])
}

// 14. Notification: In-app notifications
model Notification {
  id              String    @id @default(uuid())
  userId          String
  companyId       String?
  type            String
  title           String
  message         String
  relatedEntityId String?
  readAt          DateTime?
  createdAt       DateTime  @default(now())

  user    User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([companyId])
  @@index([readAt])
  @@index([createdAt])
}

// 15. AuditLog: Security and administrative events
model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  companyId   String?
  action      String
  targetType  String
  targetId    String?
  metadata    String?  // JSON stringified payload
  createdAt   DateTime @default(now())

  actor   User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([companyId])
  @@index([action])
  @@index([createdAt])
}
