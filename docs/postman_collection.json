{
  "info": {
    "name": "SAAA Multi-Tenant SaaS - Auth & Administration API",
    "_postman_id": "saaa-saas-auth-v1",
    "description": "Production-ready Postman collection for SAAA multi-tenant SaaS platform covering Authentication, Verification, Password Lifecycle, Super Admin Company Approvals, and Multi-tenant Employee Invitations.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://adsetsproflow.com",
      "type": "string"
    },
    {
      "key": "localBaseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "companyId",
      "value": "",
      "type": "string"
    },
    {
      "key": "invitationId",
      "value": "",
      "type": "string"
    },
    {
      "key": "resetToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "verifyToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "invitationToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register Company Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyName\": \"Starlight Media\",\n  \"adminName\": \"John Doe\",\n  \"email\": \"john@starlightmedia.io\",\n  \"password\": \"Secur3P@ssw0rd!2026\",\n  \"confirmPassword\": \"Secur3P@ssw0rd!2026\",\n  \"acceptTerms\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Registers a new Company Admin and creates a pending Company with a collision-safe slug. Verification email token is generated."
          }
        },
        {
          "name": "Login (Company Admin / Employee / Super Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner@adsetspro.com\",\n  \"password\": \"SuperAdminPass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Authenticates user credentials. Issues short-lived JWT access cookie and rotating refresh token cookie with reuse detection."
          }
        },
        {
          "name": "Get Current Authenticated User (Me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            },
            "description": "Returns current user details, active companies, role memberships, and workspace routes."
          }
        },
        {
          "name": "Rotate Refresh Token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "refresh"]
            },
            "description": "Rotates refresh token in HttpOnly cookie. Revokes old token and issues fresh JWT access token. Enforces reuse detection."
          }
        },
        {
          "name": "Logout Session",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            },
            "description": "Revokes active refresh token in database and clears authentication cookies."
          }
        }
      ]
    },
    {
      "name": "Verification & Password Lifecycle",
      "item": [
        {
          "name": "Verify Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{verifyToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/verify-email",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "verify-email"]
            },
            "description": "Marks user's email as verified using single-use verification token."
          }
        },
        {
          "name": "Resend Verification Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@starlightmedia.io\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/resend-verification",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "resend-verification"]
            },
            "description": "Rate-limited resend of verification email without leaking account existence."
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@starlightmedia.io\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "forgot-password"]
            },
            "description": "Requests password reset link. Always responds with generic success message to prevent user enumeration."
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"newPassword\": \"BrandNewP@ssw0rd2026!\",\n  \"confirmPassword\": \"BrandNewP@ssw0rd2026!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "reset-password"]
            },
            "description": "Resets user password with valid token and revokes all active sessions/refresh tokens."
          }
        },
        {
          "name": "Change Password (Authenticated)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"BrandNewP@ssw0rd2026!\",\n  \"newPassword\": \"AnotherSuperStrongP@ss2026!\",\n  \"confirmPassword\": \"AnotherSuperStrongP@ss2026!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/change-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "change-password"]
            },
            "description": "Changes user password when logged in and revokes other active sessions."
          }
        }
      ]
    },
    {
      "name": "Employee Invitations",
      "item": [
        {
          "name": "Invite Employee (Company Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sarah Designer\",\n  \"email\": \"sarah@example.com\",\n  \"designation\": \"Senior UI/UX Designer\",\n  \"department\": \"Creative\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/company/invitations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "company", "invitations"]
            },
            "description": "Active Company Admin invites an employee with designation and optional department."
          }
        },
        {
          "name": "List Company Invitations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/company/invitations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "company", "invitations"]
            },
            "description": "Fetches all pending, accepted, or revoked invitations for the authenticated company."
          }
        },
        {
          "name": "Resend Invitation",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/company/invitations/{{invitationId}}/resend",
              "host": ["{{baseUrl}}"],
              "path": ["api", "company", "invitations", "{{invitationId}}", "resend"]
            },
            "description": "Resends an active invitation with a newly generated secure token."
          }
        },
        {
          "name": "Revoke Invitation",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/company/invitations/{{invitationId}}/revoke",
              "host": ["{{baseUrl}}"],
              "path": ["api", "company", "invitations", "{{invitationId}}", "revoke"]
            },
            "description": "Revokes an invitation, preventing any future acceptance."
          }
        },
        {
          "name": "Accept Employee Invitation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{invitationToken}}\",\n  \"name\": \"Sarah Designer\",\n  \"password\": \"EmployeeSecurePass123!\",\n  \"confirmPassword\": \"EmployeeSecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/invitations/accept",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invitations", "accept"]
            },
            "description": "Invited employee sets their password, creates/activates user account, and joins company with EMPLOYEE role."
          }
        }
      ]
    },
    {
      "name": "Super Admin Portal",
      "item": [
        {
          "name": "List All Companies",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/super-admin/companies",
              "host": ["{{baseUrl}}"],
              "path": ["api", "super-admin", "companies"]
            },
            "description": "Super Admin lists all registered companies with stats, admin contacts, verification status, and employee counts."
          }
        },
        {
          "name": "Approve Company",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Company registration verified and approved.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/super-admin/companies/{{companyId}}/approve",
              "host": ["{{baseUrl}}"],
              "path": ["api", "super-admin", "companies", "{{companyId}}", "approve"]
            },
            "description": "Super Admin approves pending company registration, setting status to ACTIVE and activating company admin workspace access."
          }
        },
        {
          "name": "Reject Company",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Incomplete verification information provided.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/super-admin/companies/{{companyId}}/reject",
              "host": ["{{baseUrl}}"],
              "path": ["api", "super-admin", "companies", "{{companyId}}", "reject"]
            },
            "description": "Super Admin rejects company registration with recorded reason in AuditLog."
          }
        },
        {
          "name": "Suspend Company",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Policy violation or payment lapse.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/super-admin/companies/{{companyId}}/suspend",
              "host": ["{{baseUrl}}"],
              "path": ["api", "super-admin", "companies", "{{companyId}}", "suspend"]
            },
            "description": "Super Admin suspends an active company, instantly blocking all company workspace routes."
          }
        },
        {
          "name": "Reactivate Company",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Issue resolved, company access restored.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/super-admin/companies/{{companyId}}/reactivate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "super-admin", "companies", "{{companyId}}", "reactivate"]
            },
            "description": "Restores suspended company to ACTIVE status."
          }
        },
        {
          "name": "View Security Audit Logs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/super-admin/audit-logs?limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "super-admin", "audit-logs"],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            },
            "description": "Returns security audit trails including Super Admin actions, logins, status changes, and token revocations."
          }
        }
      ]
    }
  ]
}
